---
import A from "@/assets/square_alphabet/A.astro";
import B from "@/assets/square_alphabet/B.astro";
import C from "@/assets/square_alphabet/C.astro";
import E from "@/assets/square_alphabet/E.astro";
import K from "@/assets/square_alphabet/K.astro";
import M from "@/assets/square_alphabet/M.astro";
import N from "@/assets/square_alphabet/N.astro";
import O from "@/assets/square_alphabet/O.astro";
import S from "@/assets/square_alphabet/S.astro";
import W from "@/assets/square_alphabet/W.astro";
import H from "@/assets/square_alphabet/H.astro";
import Y from "@/assets/square_alphabet/Y.astro";

const { toolTipText = "Why not !?"} = Astro.props;

const textSize = 50;
const firstRowColor = "none";//hsl(142deg 71% 65%)";
const secondRowColor = "none";//hsl(195deg 100% 50%)";
const thirdRowColor = "none";//hsl(280deg 64% 61%)";
const strokeColor = "white";

const toolTipTextSize = 40;
---

<div class="placeholder">
  <wa-tooltip for="tooltip">{toolTipText}</wa-tooltip>

    <div class="text-row">
      <C
        id="c1"
        width={textSize}
        height={textSize}
        fill={firstRowColor}
        stroke={strokeColor}
      />
      <O
        id="o1"
        width={textSize}
        height={textSize}
        fill={firstRowColor}
        stroke={strokeColor}
      />
      <M
        id="m"
        width={textSize}
        height={textSize}
        fill={firstRowColor}
        stroke={strokeColor}
      />
      <E
        id="e"
        width={textSize}
        height={textSize}
        fill={firstRowColor}
        stroke={strokeColor}
      />
    </div>
    <div class="text-row">
      <B
        id="b"
        width={textSize}
        height={textSize}
        fill={secondRowColor}
        stroke={strokeColor}
      />
      <A
        id="a"
        width={textSize}
        height={textSize}
        fill={secondRowColor}
        stroke={strokeColor}
      />
      <C
        id="c2"
        width={textSize}
        height={textSize}
        fill={secondRowColor}
        stroke={strokeColor}
      />
      <K
        id="k"
        width={textSize}
        height={textSize}
        fill={secondRowColor}
        stroke={strokeColor}
        rightHoleFill="#0e1111"
        rightHoleStroke="#0e1111"
      />
    </div>
    <div class="text-row">
      <S
        id="s"
        width={textSize}
        height={textSize}
        fill={thirdRowColor}
        stroke={strokeColor}
      />
      <O
        id="o2"
        width={textSize}
        height={textSize}
        fill={thirdRowColor}
        stroke={strokeColor}
      />
      <O
        id="o3"
        width={textSize}
        height={textSize}
        fill={thirdRowColor}
        stroke={strokeColor}
      />
      <N
        id="n"
        width={textSize}
        height={textSize}
        fill={thirdRowColor}
        stroke={strokeColor}
      />
    </div>

  <div id="tooltip">
    <W
      width={toolTipTextSize}
      height={toolTipTextSize}
      stroke="white"
    />
    <H
      width={toolTipTextSize}
      height={toolTipTextSize}
      stroke="white"
    />
    <Y
      width={toolTipTextSize}
      height={toolTipTextSize}
      stroke="white"
    />
  </div>
</div>

<style>
  .placeholder {
    align-items: center;
    background: #0e1111;
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
    justify-content: center;
  }

  .text-row {
    display: flex;
    flex-direction: row;
    background: linear-gradient(
        135deg,
        #8055ff 0%,
        #8080ff 50%,
        #80ddff 100%
    );
  }

  #tooltip {
    display: flex;
    flex-direction: row;
    position: absolute;
    top: 5px;
    left: 5px;
    gap: 5px;
    z-index: 1;
  }
</style>

<script>
  import "@awesome.me/webawesome/dist/components/tooltip/tooltip.js"
</script>
